/* Style for the Card */
.card {
    margin-top: 20px;
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

/* Card Image */
.card-img-top {
    width: 100%;
    height: 300px; /* Adjust the height of the image */
    object-fit: cover;
}

/* Card Title */
.card-title {
    font-size: 1.5rem;
    font-weight: bold;
}

/* Card Text */
.card-text {
    font-size: 1rem;
    margin-bottom: 10px;
}

/* Button Styling */
.btn-primary {
    padding: 8px 20px;
    font-size: 16px;
    background-color: #2563eb;
    border: none;
    border-radius: 8px;
}

.btn-primary:hover {
    background-color: #1e4fc5;
}
