</head>
<body>

<main class="page-center">
    <div class="card">
        <img class="avatar" src="user_profile.jpg" alt="User Picture">
        <button class="edit-btn" onclick="window.location.href='edit.html';">Edit Profile</button>
        <button class="dm" onclick="window.location.href='chat.html';">
