        <h1 class="user-name">Soukaina Alwosaibae</h1>
        <p class="user-collage">KU - Computer Science</p>
        
        <!-- Cards for Found and Lost Items -->
        <div class="row">
            <div class="col-md-6">
                <div class="card2">
                    <img src="RED.jpeg" class="card-img-top" alt="Found Item">
                    <div class="card-body">
                        <h5 class="card-title">FOUND ITEM</h5>
                        <p class="card-text">بوك طايح بعلوم جنوبي صوب بيك لونه أحمر</p>
                        <a href="found.html" class="btn btn-primary">More details</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card2">
                    <img src="apm monaco.jpeg" class="card-img-top" alt="Lost Item">
                    <div class="card-body">
                        <h5 class="card-title">LOST ITEM</h5>
                        <p class="card-text"> i lost my APM ring please if u found it contact me</p>
                        <a href="lost.html" class="btn btn-primary"> More details</a>
