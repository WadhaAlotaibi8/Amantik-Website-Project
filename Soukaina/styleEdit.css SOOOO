/* General Body and Page Layout */
body {
    background-color: #f0f2f5;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

.page-center {
    min-height: 200vh;
    display: grid;
    place-items: center;
    padding: 24px;
}

/* Main Profile Card */
.card {
    width: min(1000px, 92vw);
    min-height: 500px;
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    padding: 40px;
    position: relative;
    padding-top: 100px;
}

/* Avatar Styling */
.avatar {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #fff;
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    margin-bottom: 16px;
}

/* User Info Styling */
.user-name {
    text-align: center;
    color: rgb(55, 54, 54);
    margin-top: 10px;
    font-size: 40px;
    font-weight: bold;
}

.user-collage {
    text-align: center;
    color: rgb(121, 121, 121);
    font-size: 20px;
}

/* Edit Profile Button Styling */
.edit-btn {
    display: block;
    margin: 20px auto;
    padding: 8px 18px;
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    background: #2563eb;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    text-align: center;
}

.edit-btn:hover {
    background: #1e4fc5;
}

/* DM Button Styling */
.dm {
    position: absolute;
    top: 70px;
    right: 90px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
}

.dm img {
    width: 90.6px;
    height: 50.66px;
}

.dm:hover {
    opacity: 0.8;
}

/* Found and Lost Item Cards */
.card2 {
    width: 100%;
    padding: 15px;
    height: 300px;
    box-sizing: border-box;
    margin-bottom: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

/* Image Styling for Cards */
.card-img-top {
    width: 100%;
    height: 150px;
    object-fit: cover;
}

/* Card Title Styling */
.card-title {
    font-size: 1.1rem;
    margin-bottom: 5px;
}

/* Card Text Styling */
.card-text {
    font-size: 0.9rem;
    margin-bottom: 10px;
}

/* Button Styling in Cards */
.btn-primary {
    padding: 6px 12px;
    font-size: 14px;
}
